# =====================================================================
# Islamic Life Companion — Environment configuration template
# Copy this file to ".env" and fill in the values.
# NEVER commit your real .env file (it is in .gitignore).
# =====================================================================

# Runtime environment: "development" | "staging" | "production"
ENV=development

# Database connection string
# Examples:
#   SQLite (default, zero setup):   sqlite:///./islamic_life_companion.db
#   PostgreSQL:                     postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./islamic_life_companion.db

# ---- Security ----
# Generate a strong secret with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string-before-production
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Seed admin (only used by seeding scripts) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123